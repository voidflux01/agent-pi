    "@mariozechner/pi-coding-agent": "npm:@earendil-works/pi-coding-agent@^0.84.3",
    "@mariozechner/pi-tui": "npm:@earendil-works/pi-tui@^0.84.3",
    "pi-lsp-client": "github:code-yeongyu/pi-lsp-client",
    "pi-mcp-adapter": "github:nicobailon/pi-mcp-adapter",
